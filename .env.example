# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Server-side only (Express / Node) ─────────────────────────────────────────
# TokenHub API Key — used ONLY in server/index.js, never sent to the browser.
# Get yours from: https://console.tencentcloud.com/tokenhub
TOKENHUB_API_KEY=your_tokenhub_api_key_here

# Optional: Express server port (default: 3001)
# PORT=3001

# ── Client-side (Vite frontend) ───────────────────────────────────────────────
# Override if you deploy the Express server somewhere other than localhost.
# In local dev you do NOT need to set this — it defaults to http://localhost:3001.
# VITE_API_BASE=http://localhost:3001
